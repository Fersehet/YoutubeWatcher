# Copy this file to .env and fill it in. Without .env (or without ADMIN_PASSWORD)
# YoutubeWatchr runs locally on this computer only, without a login, like before.

# Online with login: the editor needs this user and password. The overlays for OBS
# and the extension use their own keys, which the editor shows after signing in.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Port for the editor, the overlay and the extension (http://localhost:PORT)
PORT=8974

# Optional: where to listen. Default online 0.0.0.0 (reachable from the network and from Docker), locally 127.0.0.1.
HOST=

# Optional: folder for the keys and saved settings (default: data/ next to server.js)
DATA_DIR=

# Optional: folder with a start page for /, e.g. the YoutubeWatchr website (default: website/ next to server.js).
# Without a start page, / leads to the editor.
SITE_DIR=

# Optional: key for the login cookies (otherwise created once in data/session-secret)
SESSION_SECRET=
